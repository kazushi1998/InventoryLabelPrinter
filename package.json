{
  "name": "inventory-label-printer-electron",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop inventory label printer for Citizen CLP-7201e and local label counters.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "prepare:icons": "node scripts/write-icon.js",
    "dist": "node scripts/write-icon.js && electron-builder --win portable",
    "dist:dir": "node scripts/write-icon.js && electron-builder --win dir",
    "dist:setup": "node scripts/write-icon.js && electron-builder --win nsis"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "local.inventory.labelprinter",
    "productName": "Inventory Label Printer",
    "files": [
      "src/**/*",
      "assets/**/*",
      "scripts/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    }
  }
}
